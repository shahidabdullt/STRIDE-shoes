APP_NAME=Stride
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000              # production: https://<your-domain> (must match exactly, see BLUEPRINT §5.1)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 is the target database (CLAUDE.md §5). Tests use the stride_testing database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stride
DB_USERNAME=stride
DB_PASSWORD=

QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false                # true in production

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gemini (server side only; never expose to the browser) ---
GEMINI_API_KEY=
# Text model: gemini-3.6-flash is the default (verified in Phase 0, chosen 8 Nov 2026); gemini-3.8-flash was unavailable on a free-tier key.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_HTTP_TIMEOUT=20
GEMINI_LIVE_TOKEN_TTL_SECONDS=720
GEMINI_LIVE_NEW_SESSION_TTL_SECONDS=60

# --- Store and assistant ---
STORE_CURRENCY=USD
VOICE_DEFAULT_MODE_MOBILE=hold_to_talk
VOICE_DEFAULT_MODE_DESKTOP=hands_free
ASSISTANT_ACCESS_CODE=                     # empty = no gate
ASSISTANT_DAILY_CHAT_CAP=2000
ASSISTANT_DAILY_VOICE_SESSION_CAP=100
ASSISTANT_REDACT_EMAILS=true
CONVERSATION_RETENTION_DAYS=30
CONVERSATION_IDLE_MINUTES=15

VITE_APP_NAME="${APP_NAME}"
